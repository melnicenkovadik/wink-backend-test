{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && mkdir -p public && cp docs/openapi.yaml public/",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist,docs,node_modules/swagger-ui-dist}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
